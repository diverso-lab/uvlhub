WORKING_DIR=/workspace
SPLENT_APP=uvlhub
PYTHONPATH=/workspace/uvlhub/src
FLASK_APP=uvlhub:create_app

MARIADB_HOSTNAME=uvlhub_db
MARIADB_DATABASE=uvlhub_db
MARIADB_TEST_DATABASE=uvlhub_db_test
MARIADB_USER=uvlhub_db_user
