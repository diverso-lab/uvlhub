# Optional settings. Uncomment a line to use it.
#
# Gunicorn workers. Unset means 2 x CPUs + 1, counted by nproc in the
# container, which does not see a --cpus quota. Each worker holds its
# own copy of the app in memory.
# GUNICORN_WORKERS=4
#
# Cookies marked Secure, sent over HTTPS only. Unset means Secure
# whenever the request arrived over HTTPS, directly or through the
# trusted proxy. true forces it on every cookie, false never sets it.
# SPLENT_COOKIE_SECURE=true
#
# Image the web service runs instead of the one docker-compose.yml
# names. The autodeploy feature follows it.
# SPLENT_IMAGE=git.splent.io/<org>/<product>:stable
#
# Host port of the web app. Unset means the one docker-compose.yml names.
# SPLENT_WEB_PORT=8080
#
# Host port of the database, on loopback unless SPLENT_DB_BIND_HOST
# says otherwise. Unset means the one docker-compose.yml names.
# SPLENT_DB_PORT=33060
#
# Largest request body the app reads, in bytes or with K, M or G.
# Bigger uploads get 413. Unset means 16 MB, 0 means no limit.
# MAX_CONTENT_LENGTH=64M
