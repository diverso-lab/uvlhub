WORKING_DIR=/workspace
SPLENT_APP=uvlhub_splent
PYTHONPATH=/workspace/uvlhub_splent/src
FLASK_APP=uvlhub_splent:create_app

# Signs sessions, CSRF tokens and every link the app has to trust (password
# resets). product:deploy generates a random one when it finds <SET>; on a
# host without the CLI use: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=<SET>

MARIADB_HOSTNAME=uvlhub_splent_db_deploy
MARIADB_DATABASE=<SET>
MARIADB_USER=<SET>
MARIADB_PASSWORD=<SET>
MARIADB_ROOT_PASSWORD=<SET>

RUN_DB_SEED=false

# Host interfaces for the ports published by docker-compose.prod.yml.
# 127.0.0.1 keeps them reachable only from the host itself, the right setup
# when a proxy on the host terminates TLS and forwards to loopback. Set a
# variable to 0.0.0.0, or delete its line, to publish on all interfaces.
# user-tunable
SPLENT_WEB_BIND_HOST=127.0.0.1
# user-tunable
SPLENT_DB_BIND_HOST=127.0.0.1

# Persistent data directories inside the web container. They are the mount
# targets of the named volumes declared in docker-compose.prod.yml, so their
# contents survive redeploys. PROTECTED_UPLOADS_DIR holds uploads served
# through the app (outside static/), ARCHIVE_DIR holds extra static content.
# Change a path only together with the matching volume in the compose file.
# user-tunable
PROTECTED_UPLOADS_DIR=/workspace/uvlhub_splent/protected_uploads
# user-tunable
ARCHIVE_DIR=/workspace/uvlhub_splent/archive

# ── Where the hub is published ───────────────────────────────────────────
#
# The topology: a TLS terminator on the host (nginx, Caddy, Traefik)
# answers 443 and forwards to splent_feature_nginx on 127.0.0.1, at
# NGINX_HTTP_HOST_PORT (92 with this product's port offset), and nginx
# forwards to the web container. The nginx feature listens on HTTP only,
# so HTTPS needs that terminator. Point it at nginx and not at the web
# port 5012: the Host check, the rate limit on the account forms, the
# long timeouts of the Zenodo routes and the redacted access log are all
# nginx's. The terminator has to keep the Host it received and set
# X-Forwarded-For and X-Forwarded-Proto.

# The public host, without scheme or port, for example www.uvlhub.io. The
# links the app builds outside a request (a reindex from the command line,
# a background task) use it; inside a request the host comes from the
# request, which nginx lets through only for NGINX_SERVER_NAME. Only
# dataset reads it, and never into Flask's config, so it does not tie the
# routing to one host. product:deploy asks for it.
SERVER_NAME=<SET>
# The scheme of those links.
# user-tunable
PREFERRED_URL_SCHEME=https
# The address the ORCID and GitHub callbacks are built on, scheme
# included, for example https://www.uvlhub.io. It has to be the one
# registered with each provider, whatever Host a request came with.
# product:deploy asks for it.
OAUTH_REDIRECT_BASE_URL=<SET>
# Every name nginx answers to, separated by spaces: SERVER_NAME and its
# aliases, for example "www.uvlhub.io uvlhub.io". Any other Host, and a
# request without one, gets its connection closed before it reaches the
# app, which builds reset and confirmation links from the Host. Without
# this line the nginx feature's localhost would close the real site.
# product:deploy asks for it.
NGINX_SERVER_NAME=<SET>

# ── Proxies ──────────────────────────────────────────────────────────────
#
# nginx believes the terminator and nobody else. The terminator reaches
# the published port from the docker network's gateway, inside
# 172.16.0.0/12 (the peer= field of nginx's access log shows the address
# it arrives from), and the port is published on loopback, so no one else
# arrives from there. Behind it, nginx takes the scheme, the host and the
# client address from the terminator's headers, which is what lets it
# rate limit per client and not per terminator.
# user-tunable
NGINX_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# user-tunable
NGINX_BIND_HOST=127.0.0.1

# How many reverse proxies the app believes: 1, nginx, which is the only
# hop the app talks to. nginx decides whether to believe the terminator
# and forwards one X-Forwarded-For (the client), one X-Forwarded-Proto and
# one X-Forwarded-Host. 2, which the CLI suggests for the nginx feature
# behind a TLS front, makes the app look for two values in each, find
# one, and ignore them: http:// links (GitHub refuses such a callback),
# cookies without Secure, no HSTS. 1 is also right when nginx is the edge
# (leave NGINX_TRUSTED_PROXY_CIDRS empty and NGINX_BIND_HOST at 0.0.0.0
# then) and when a terminator forwards to the web port directly. 0 means
# nothing is in front and no X-Forwarded header is believed. Never set it
# higher than the real number of proxies, or a caller can choose the
# client address the app sees (rate limits, logs, sessions).
# user-tunable
SPLENT_TRUSTED_PROXIES=1

# Gunicorn worker processes in the web container. Left unset, the start
# script uses 2 x CPUs + 1, with the CPUs counted by nproc inside the
# container. nproc sees a cpuset limit but not a --cpus quota, and every
# worker holds its own copy of the app in memory, so on a shared host or a
# small VM set the number by hand.
# GUNICORN_WORKERS=4

# Whether cookies are marked Secure, sent over HTTPS only. Left unset they
# are Secure whenever the request arrived over HTTPS, directly or through
# the trusted proxy above, and plain HTTP still works. true forces Secure
# on every cookie, false never sets it.
# SPLENT_COOKIE_SECURE=true

# Largest request body the app reads, in bytes or with K, M or G. Bigger
# uploads get 413. Left unset it is 16 MB; 0 means no limit. Raise it when a
# feature takes larger files.
# MAX_CONTENT_LENGTH=64M

# Uncomment only behind a proxy that sets X-Forwarded-Prefix (an app mounted
# under a path), so the links the app builds keep that prefix. Use
# prefix,port if it also sets X-Forwarded-Port. Read only when
# SPLENT_TRUSTED_PROXIES is 1 or more.
# SPLENT_TRUSTED_PROXY_HEADERS=prefix

# ── Timeouts ─────────────────────────────────────────────────────────────
#
# Publishing to Zenodo still runs inside the request. zenodo bounds each
# call (5 s to connect, 30 s to answer, 90 s for the upload), not the
# publication: a first publication can take about four minutes and a new
# version close to six, and building a big dataset's ZIP adds to it. nginx
# gives the publishing routes and the ZIP downloads
# NGINX_LONG_REQUEST_TIMEOUT, every other request 120 s. The worker's limit
# is a little above it, so nginx gives up first and the worker still
# stores the DOI Zenodo minted; killed after the publish, it would leave a
# DOI the hub never recorded. GUNICORN_TIMEOUT applies to every request,
# since gunicorn cannot tell them apart, until publications run as
# background jobs.
# user-tunable
NGINX_LONG_REQUEST_TIMEOUT=600s
# user-tunable
GUNICORN_TIMEOUT=630

# ── Mail ─────────────────────────────────────────────────────────────────
#
# Email confirmation, password reset and dataset transfer mails. Without
# these lines the mail feature's defaults (localhost:1025, MailHog) would
# send nothing in production and leave only a warning in the log.
# MAIL_USE_TLS is STARTTLS, on the submission port 587; uvlhub.io sent
# through smtp.office365.com.
MAIL_HOST=<SET>
# user-tunable
MAIL_PORT=587
# user-tunable
MAIL_USE_TLS=true
MAIL_USERNAME=<SET>
# product:deploy offers a random value for every *_PASSWORD, which is right
# for Redis and Elasticsearch below and wrong here: type the SMTP account's
# password. With --ci, export MAIL_PASSWORD before deploying.
MAIL_PASSWORD=<SET>
# The sender every mail shows, an address that exists and takes replies,
# for example no-reply@uvlhub.io. The admin panel can change it later.
MAIL_FROM=<SET>

# ── Secrets the features ask for themselves ──────────────────────────────
#
# Not repeated here: each feature's own docker/.env.prod.example asks for
# them and product:build carries them into deploy/.env.example as
# required. product:deploy generates the two passwords and asks for the
# token.
#   REDIS_PASSWORD          redis runs its server with it and puts it into
#                           the URLs the app uses (sessions, tasks,
#                           caches). Compose refuses to start without it.
#   ELASTICSEARCH_PASSWORD  elasticsearch runs the node with security on:
#                           it is the password of the "elastic" user, which
#                           the app signs in as (ELASTICSEARCH_USERNAME,
#                           which the feature declares). For a cluster this
#                           product does not run, ELASTICSEARCH_API_KEY and
#                           ELASTICSEARCH_URL replace both.
#   ZENODO_ACCESS_TOKEN     zenodo publishes with it. Zenodo issues it,
#                           with the deposit:write and deposit:actions
#                           scopes.
# ORCID_CLIENT_ID and ORCID_CLIENT_SECRET, GITHUB_CLIENT_ID and
# GITHUB_CLIENT_SECRET are not required: left empty, signing in with that
# provider is off. Each app is registered with its callback on
# OAUTH_REDIRECT_BASE_URL (/orcid/authorize, /github/authorize).
